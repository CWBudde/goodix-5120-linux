+++ b/libfprint/meson.build
@@ -134,6 +134,14 @@ driver_sources = {
         'drivers/goodixmoc/goodix.c',
         'drivers/goodixmoc/goodix_proto.c',
     ),
+    'goodix5120' : files(
+        'drivers/goodix5120/goodix5120.c',
+        'drivers/goodix5120/goodix5120_match.c',
+        'drivers/goodix5120/goodix5120_proto.c',
+        'drivers/goodix5120/goodix5120_sigfm.cpp',
+        'drivers/goodix5120/goodix5120_tls.c',
+        'drivers/goodix5120/sigfm/sigfm.cpp',
+    ),
     'fpcmoc' : files('drivers/fpcmoc/fpc.c'),
     'realtek' : files('drivers/realtek/realtek.c'),
     'focaltech_moc' : files('drivers/focaltech_moc/focaltech_moc.c'),
@@ -145,6 +153,7 @@ helper_sources = {
     'aeslib': files('drivers/aeslib.c'),
     'aesx660': files('drivers/aesx660.c'),
     'aes3k': files('drivers/aes3k.c'),
+    'opencv': files(),
     'openssl': files(),
     'pixman': files(),
     'udev': files(),
diff --git a/meson.build b/meson.build
index ab09dc1d..7832fc2e 100644
--- a/meson.build
